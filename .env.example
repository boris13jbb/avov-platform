# =============================================================================
# AVOV — Variables de entorno (copiar a .env y ajustar valores)
# =============================================================================

# --- Aplicación ---
APP_NAME=AVOV
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=avov_root_secret
MYSQL_DATABASE=avov_db
MYSQL_USER=avov_user
MYSQL_PASSWORD=avov_user_secret
MYSQL_HOST=mysql
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://avov_user:avov_user_secret@mysql:3306/avov_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CAREERS=avov_careers
QDRANT_VECTOR_SIZE=384

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Seguridad HTTP (OWASP) ---
SECURITY_HEADERS_ENABLED=true
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Recuperación de contraseña ---
PASSWORD_RESET_EXPIRE_HOURS=1
FRONTEND_BASE_URL=http://localhost:8080

# --- SMTP (opcional; si SMTP_ENABLED=false el enlace se registra en logs) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@avov.local

# --- DeepSeek API ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

# --- phpMyAdmin (solo desarrollo) ---
PHPMYADMIN_PORT=8081
PMA_HOST=mysql
PMA_PORT=3306

# --- Frontend ---
API_BASE_URL=http://localhost:8000/api/v1
