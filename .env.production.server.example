# =============================================================================
# AVOV - Plantilla SERVidor REAL (Fase 42)
# Copiar a .env en el servidor Linux y reemplazar dominios/claves.
# NO usar en desarrollo local.
# =============================================================================

APP_NAME=AVOV
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CAMBIAR-clave-secreta-minimo-32-caracteres-aleatorios

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://app.tudominio.edu.co
FRONTEND_BASE_URL=https://app.tudominio.edu.co

MYSQL_ROOT_PASSWORD=CAMBIAR-root-mysql-fuerte
MYSQL_DATABASE=avov_db
MYSQL_USER=avov_user
MYSQL_PASSWORD=CAMBIAR-password-mysql-fuerte
MYSQL_HOST=mysql
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://avov_user:CAMBIAR-password-mysql-fuerte@mysql:3306/avov_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CAREERS=avov_careers
QDRANT_VECTOR_SIZE=384

JWT_SECRET_KEY=CAMBIAR-jwt-secreto-minimo-32-caracteres-aleatorios
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=3600

SECURITY_HEADERS_ENABLED=true
BACKEND_ALLOWED_HOSTS=api.tudominio.edu.co

DEEPSEEK_API_KEY=CAMBIAR-tu-api-key-deepseek
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

UVICORN_WORKERS=2

API_BASE_URL=https://api.tudominio.edu.co/api/v1

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tudominio.edu.co
SMTP_FROM_NAME=AVOV

# Dominios (referencia operativa)
API_DOMAIN=api.tudominio.edu.co
FRONTEND_DOMAIN=app.tudominio.edu.co
