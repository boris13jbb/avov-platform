APP_NAME=AVOV
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=CAMBIAR-clave-secreta-minimo-32-caracteres-aleatorios

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=https://app.tudominio.edu.co

MYSQL_ROOT_PASSWORD=CAMBIAR-root-mysql-fuerte
MYSQL_DATABASE=avov_db
