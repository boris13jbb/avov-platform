# =============================================================================
# AVOV — Variables PROD LOCAL (simula prod-up.ps1 sin tocar .env de desarrollo)
# Copiar a .env.prod-local y ajustar si es necesario.
# Uso: .\scripts\prod-local-up.ps1
# =============================================================================

APP_NAME=AVOV
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=ProdLocal-Secret-Key-Min-32-Chars-OK-2026

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

MYSQL_ROOT_PASSWORD=ProdLocalRoot_MySql_Pass_2026!
MYSQL_DATABASE=avov_db
MYSQL_USER=avov_user
MYSQL_PASSWORD=ProdLocalUser_MySql_Pass_2026!
MYSQL_HOST=mysql
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://avov_user:ProdLocalUser_MySql_Pass_2026!@mysql:3306/avov_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CAREERS=avov_careers
QDRANT_VECTOR_SIZE=384

JWT_SECRET_KEY=ProdLocal-JWT-Secret-Key-Min-32-Chars-OK
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_MAX=5
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=3600

SECURITY_HEADERS_ENABLED=true
BACKEND_ALLOWED_HOSTS=localhost,127.0.0.1

DEEPSEEK_API_KEY=prod-local-placeholder-no-real-api-calls
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

NGINX_HTTP_PORT=8090
NGINX_HTTPS_PORT=8443

UVICORN_WORKERS=2

API_BASE_URL=http://localhost:8090/api/v1
FRONTEND_BASE_URL=http://localhost:8090

SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@avov.prod-local
